# syntax=docker/dockerfile:1.6
# Production llama.cpp server with KleidiAI for ARM64 (Axion / Neoverse).
# Build: docker buildx build --platform linux/arm64 -f docker/Dockerfile.llama-kleidiai -t nexus-arm/llama-kleidiai:server .

FROM ubuntu:24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git ca-certificates curl \
    clang libomp-dev libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
ARG LLAMA_CPP_REF=master
RUN git clone --depth 1 --branch "${LLAMA_CPP_REF}" https://github.com/ggml-org/llama.cpp.git

WORKDIR /src/llama.cpp
# RelWithDebInfo + frame pointers so Performix hotspots resolve to kai_*/ggml_* symbols.
# KleidiAI + native ARM ISA. Avoid GGML_CPU_ALL_VARIANTS (needs GGML_BACKEND_DL).
RUN cmake -B build \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_C_COMPILER=clang \
        -DCMAKE_CXX_COMPILER=clang++ \
        -DCMAKE_C_FLAGS="-fno-omit-frame-pointer -g -Wl,--build-id=sha1" \
        -DCMAKE_CXX_FLAGS="-fno-omit-frame-pointer -g -Wl,--build-id=sha1" \
        -DGGML_CPU_KLEIDIAI=ON \
        -DGGML_NATIVE=ON \
        -DGGML_OPENMP=ON \
        -DGGML_CCACHE=OFF \
        -DGGML_BLAS=OFF \
        -DGGML_CUDA=OFF \
        -DGGML_METAL=OFF \
    && cmake --build build --config RelWithDebInfo -j"$(nproc)" \
    && install -d /opt/llama/bin /opt/llama/lib \
    && cp -a build/bin/. /opt/llama/bin/ \
    && find build -name '*.so*' -exec cp -a {} /opt/llama/lib/ \; \
    && (test -x /opt/llama/bin/llama-server || install -m 0755 build/bin/llama-server /opt/llama/bin/llama-server)
# Do not strip — keep DWARF for apx/neoprof symbolization.

FROM ubuntu:24.04 AS runtime
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 libomp5 libcurl4 ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/llama /opt/llama
ENV PATH="/opt/llama/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/llama/lib:/opt/llama/bin"
RUN echo "/opt/llama/lib" > /etc/ld.so.conf.d/llama.conf \
    && echo "/opt/llama/bin" >> /etc/ld.so.conf.d/llama.conf \
    && ldconfig
# SME auto-detect unless overridden
# ENV GGML_KLEIDIAI_SME=
EXPOSE 8080
VOLUME ["/models"]
ENTRYPOINT ["llama-server"]
CMD ["--host", "0.0.0.0", "--port", "8080"]
