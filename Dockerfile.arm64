FROM --platform=linux/arm64 python:3.12-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NSA_HOST=0.0.0.0 \
    NSA_PORT=8000

ARG BTOP_VERSION=1.4.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates htop procps sysstat \
    && (apt-get install -y --no-install-recommends btop \
        || (curl -fsSL "https://github.com/aristocratos/btop/releases/download/v${BTOP_VERSION}/btop-aarch64-linux-musl.tbz" -o /tmp/btop.tbz \
            && mkdir -p /tmp/btop-extract \
            && tar -xjf /tmp/btop.tbz -C /tmp/btop-extract \
            && install -m 0755 /tmp/btop-extract/btop/bin/btop /usr/local/bin/btop \
            && rm -rf /tmp/btop.tbz /tmp/btop-extract)) \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

COPY pyproject.toml README.md LICENSE requirements-gateway.txt /app/
COPY neuroswarm_arm /app/neuroswarm_arm
COPY templates /app/templates
COPY okf /app/okf
COPY packages/okf /app/packages/okf

ENV FASTEMBED_CACHE_PATH=/app/.fastembed_cache \
    NSA_ROUTER_FASTEMBED_CACHE=/app/.fastembed_cache \
    NSA_ROUTER_EMBEDDING_BACKEND=fastembed

# Split install to avoid single-layer bloat; purge pip cache between
RUN pip install --no-cache-dir -r /app/requirements-gateway.txt \
    && pip install --no-cache-dir /app/packages/okf \
    && pip install --no-cache-dir --no-deps -e . \
    && rm -rf /root/.cache/pip /tmp/pip-* /tmp/tmp* \
    && find /usr/local/lib/python3.12/site-packages -name "*.pyc" -delete 2>/dev/null || true \
    && find /usr/local/lib/python3.12/site-packages -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true

# Pre-download FastEmbed model in isolated layer
RUN mkdir -p /app/.fastembed_cache \
    && python -c "from fastembed import TextEmbedding; TextEmbedding(model_name='nomic-ai/nomic-embed-text-v1.5', cache_dir='/app/.fastembed_cache')" \
    && rm -rf /root/.cache /tmp/*

EXPOSE 8000
CMD ["python", "-m", "neuroswarm_arm.main"]
