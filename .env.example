MODEL_DIR=./models
# Axion VM: set MODEL_DIR=/models when GGUF files live under /models (see scripts/ensure-compose-models.sh)
# Windows x86 local dev: use docker-compose.local.yaml (sets ghcr.io/ggml-org/llama.cpp:server)
# Docker Desktop -> Settings -> Resources -> Memory: 16 GiB for tier1+tier2+tier3+gateway
# MUST be KleidiAI build for Arm proof — never leave stock ghcr.io/ggml-org/llama.cpp:server
NSA_LLAMA_IMAGE=nexus-arm/llama-kleidiai:server
NSA_LLAMA_N_PARALLEL=8
NSA_LLAMA_CTX_SIZE=8192
NSA_LLAMA_BATCH_SIZE=512
NSA_LLAMA_THREADS_BATCH=8
NSA_LLAMA_CONT_BATCHING=1
# Shared directory for cross-tier llama-server slot save/restore (G8)
NSA_LLAMA_SLOT_DIR=/tmp/neuroswarm-slots
# 1 = restore draft KV on verify server before verify (0 = legacy full re-prefill)
NSA_LLAMA_SLOT_KV_REUSE=1
NSA_DIPA_BATCHING=1
NSA_DIPA_BATCH_WINDOW_MS=8
NSA_MEM_GRAPH=0
# Optional pd profile: pin a multi-arch tag that includes Arm Neoverse CPU engine (May 2026+)
NSA_SGLANG_IMAGE=lmsysorg/sglang:latest
NSA_ROUTER_TOP_K=3
# Expand / re-rank trigger (alias: NSA_ROUTER_RERANK_TRIGGER)
NSA_ROUTER_THRESHOLD=0.42
# High-confidence → RoutingResult.high_confidence + thinking_token_cap cap
NSA_ROUTER_HIGH_CONF_GATE=0.70
NSA_ROUTER_HIGH_CONF_THINKING_BUDGET=256
# CostRouter: tool_confidence below this never starts cascade at tier1 (default=threshold).
# NSA_ROUTER_ESCALATE_CONF=0.42
# Index only MCP tools whose servers answer tools/list (default 0 = static YAML).
# NSA_MCP_LIVE_INDEX=0
# Pillar 2 embeddings (production default = fastembed / BGE-small 384-dim)
NSA_ROUTER_EMBEDDING_BACKEND=fastembed
NSA_ROUTER_ENCODER=nomic-embed-text-v1.5
# BGE retrieval query prefix (queries only; documents/tools unprefixed). Set 0 to disable.
# NSA_ROUTER_BGE_QUERY_PREFIX=1
# NSA_ROUTER_FASTEMBED_CACHE=/app/work/fastembed
# TurboVec when tool count >= this (0 = use TurboVec whenever wheel imports; else exact)
NSA_ROUTER_TURBOVEC_MIN_TOOLS=0
# Dev/CI only — production must use FastEmbed/ST/ONNX (hash is fail-loud without this)
# NSA_ROUTER_ALLOW_HASH=1
# Medusa multi-head proposer (G4) — needs trained heads at NSA_MEDUSA_HEAD_PATH
NSA_MEDUSA_ENABLED=0
NSA_MEDUSA_HEAD_PATH=/models/medusa/
# Optional MCP execute manager (templates stdio + Streamable HTTP remotes)
# NSA_MCP_EXECUTE=1
# NSA_MCP_APPROVE_DESTRUCTIVE=1
# NSA_MCP_BROWSER_HOST_ALLOWLIST=example.com,api.example.com
# NSA_MCP_BROWSER_MAX_REDIRECTS=5
# NSA_MCP_PG_MAX_RESULT_BYTES=262144
# Tenant overlay: NSA_MCP_TENANT_<id>_BROWSER_HOST_ALLOWLIST=...
# NSA_MCP_RESULT_MAX_BYTES=524288
# NSA_MCP_MAX_INFLIGHT=2
# NSA_MCP_HTTP_MYREMOTE=https://mcp.example.com/mcp
# Tenant overlay: NSA_MCP_TENANT_<id>_GITHUB_TOKEN=...
# GITHUB_TOKEN=
# SERPAPI_API_KEY=
# (alias: SERP_API_KEY=)
# SLACK_BOT_TOKEN=
# DATABASE_URL=
# DATABASE_URL_READONLY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET=your-bucket-name
# S3_ENDPOINT_URL=
# ONNX path requires tokenizer (NSA_ROUTER_TOKENIZER_PATH or encoder HF id)
# NSA_ROUTER_ONNX=1
# NSA_ROUTER_ONNX_PATH=/models/bge-small.onnx
# NSA_ROUTER_TOKENIZER_PATH=nomic-embed-text-v1.5
NSA_CASCADE_CONFIDENCE_THRESHOLD=0.85
# c4a-standard-8 = 8 vCPU / 32 GB. Keep thread sum <= 8 and MVP ctx at 4096.
TIER1_THREADS=2
TIER2_THREADS=3
TIER3_THREADS=3
TIER1_CTX=4096
# PRODUCT_DEMO=1 sets TIER2_CTX=8192 for Mem0 extraction headroom
TIER2_CTX=4096
TIER3_CTX=4096
TIER3_PARALLEL=4
# Prefer Llama-3.2-8B Q4_K_M on Axion when present under MODEL_DIR (see ensure-compose-models.sh).
# TIER3_MODEL=Llama-3.2-8B-Instruct-Q4_K_M.gguf
NSA_TIER3_CPUSET=5-7
NSA_IMAGE_TAG=dev
GRAFANA_ADMIN_USER=admin
# REQUIRED before exposing Grafana on neuroswarm-obs (compose fails if empty).
# Also used to generate ops/nginx/obs.htpasswd for nginx basic auth.
GRAFANA_ADMIN_PASSWORD=

# Observability — OTEL collector on axion → Prometheus remote_write on neuroswarm-obs
# REQUIRED (compose fails without it). Use obs VM *internal* IP — not 127.0.0.1.
# Example after bootstrap-obs-vm.ps1 (this project: neuroswarm-obs = 10.128.0.3):
OBS_PROMETHEUS_REMOTE_WRITE=http://10.128.0.3:9090/prometheus/api/v1/write
# Metrics: scrape once via obs Prometheus (:80). Do NOT also export RMF/ROF metrics over OTLP
# (that remote_writes a second copy). Traces still use OTLP below.
NSA_RMF_EXPORTERS=prometheus
NSA_RMF_OTLP_ENDPOINT=http://otel-collector:4317
NSA_RMF_OTLP_INSECURE=1
NSA_RMF_PERFORMIX=1
# HTTP traces only — do not use :4317 (gRPC) here or BatchSpanProcessor will spam ConnectionReset.
NSA_ROF_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
NSA_ROF_OTLP_INSECURE=1
NSA_ROF_EXPORTERS=prometheus
NSA_DIPA_OTEL=1
NSA_DIPA_OTEL_ENDPOINT=http://otel-collector:4318/v1/traces
NSA_AROP_PERFORMIX=1
NSA_AROP_PERFORMIX_BIN=apx
# Live Axion path: compose profile performix starts performix-bridge (HTTP /mcp).
# Product MCP for AROP = performix-bridge wrapping host `apx` (NOT official Arm MCP).
# When profile is up, set: NSA_AROP_PERFORMIX_MCP=http://performix-bridge:8090
# (compose aliases performix-bridge → host-gateway; bridge uses host network + host apx)
# Leave empty when profile is off (CLI/cron still valid — preferred automation path).
NSA_AROP_PERFORMIX_MCP=
# hybrid = PerformixAware knobs + GEPA text; performix = knobs-only Performix rules
NSA_AROP_REFLECTION=hybrid
# Background RuntimeOptimizer.run_once (0=off). auto_promote stays off.
NSA_AROP_LOOP=0
# GEPA teacher LM: mock (CI) | OpenAI-compatible base (e.g. http://tier2:8080/v1)
NSA_AROP_GEPA_LM=mock
NSA_AROP_GEPA_LM_MODEL=default
# Optional IDE-only Arm MCP (armlimited/arm-mcp) SSH mounts — not used by Compose AROP.
ARM_PERFORMIX_TARGET=
ARM_MCP_SSH_KEY=./work/keys/ssh-key.pem
ARM_MCP_KNOWN_HOSTS=./work/keys/known_hosts
# NSA_PERFORMIX_ALLOW_DEMO=0  # never write synthetic hotspots when live required
# PERFORMIX_DURATION=60       # recipe timeout seconds for refresh-performix-snapshot.sh

# Cognitive Memory (Mem0 + local Qdrant under work/)
NSA_MEM_PROVIDER=mem0
NSA_MEM_STORE=/app/work/memory
NSA_MEM_QDRANT_PATH=/app/work/memory/qdrant
NSA_MEM_QDRANT_URL=http://qdrant:6333
NSA_MEM_LLM=none
# Async multi-scope Mem0 retrieval (user/agent/run fanout) — not write batching
NSA_MEM_SCOPE_FANOUT=1
# NUMA-local Qdrant placement (multi-NUMA hosts only; no-op on Axion)
NSA_NUMA_NODE=0
# Mem0 platform tier bulk API (optional)
# NSA_MEM_PLATFORM_API_KEY=
# NSA_MEM_PLATFORM_BASE_URL=https://api.mem0.ai
# ACR Mem0 token budget (subset of NSA_ACR_TOKEN_BUDGET)
# NSA_ACR_MEM0_TOKEN_BUDGET=500
# Demo extraction (Compose): NSA_MEM_LLM=local + NSA_MEM_LLM_BASE_URL=http://tier2:8080
# Hash embedder keeps Qdrant usable when llama-server has no --embeddings.
NSA_MEM_LLM_BASE_URL=
NSA_MEM_EMBEDDER=hash

# ASCR honesty: text-agreement interim mode when logits unavailable
NSA_ASCR_TEXT_AGREE=1
# Optional demo measure: lower ASCR rounds (default 4). Does not change router gates.
# NSA_ASCR_MAX_ROUNDS=2
# Request llama.cpp n_probs/logprobs on generate (0 = off; use NSA_LLAMA_N_PROBS_DEFAULT on speculative paths)
NSA_LLAMA_N_PROBS=0
# When speculative=True and NSA_LLAMA_N_PROBS=0, backend still requests logprobs with this default
NSA_LLAMA_N_PROBS_DEFAULT=5
# G14: top-τ floor when draft missing from target top-N (0.0 = lossless / off)
NSA_ASCR_TAU_FLOOR=0.0
# G15: skip speculation under low ROI / tight SLA (off by default)
NSA_ASCR_COST_MODEL_ENABLED=0
NSA_ASCR_SKIP_HISTORICAL_MIN=0.3
NSA_ASCR_SKIP_PRESSURE_MAX=0.8
NSA_ASCR_SKIP_MAX_TOKENS_MIN=8

# G13: O(1) n-gram cache for self_speculation / ngram proposers (strategies.ngram_cache.enabled)
NSA_NGRAM_CACHE=0
NSA_NGRAM_CONTEXT_SHIFT_K=8
# G18: draft model registry — optional path override; auto-resolve (target, host_arch) pairs
NSA_DRAFT_MODEL_PATH=
NSA_DRAFT_QUANT=Q4_0
NSA_DRAFT_REGISTRY_AUTO=1
# Optional: neoverse-v2 | neoverse-v3 | apple-m | apple-pro | apple-max | x86
NSA_HOST_ARCH=
# Optional target id for DraftModelRegistry (else tier role=target / first non-draft)
NSA_TARGET_MODEL=

# EAGLE-3 draft head (G3)
# Path to trained EAGLE-3 head weights directory (config.json + model.safetensors)
NSA_EAGLE3_HEAD_PATH=/models/eagle3/
# Set to 1 to enable EAGLE-3 proposer (requires head weights to be present)
NSA_EAGLE3_ENABLED=0
# Quantization for EAGLE-3 head weights (Q4_0, Q8_0, FP16, etc.)
# NSA_EAGLE3_QUANT=Q4_0
# Reduced vocab size for EAGLE-3 draft head (must match trained head)
# NSA_EAGLE3_REDUCED_VOCAB=32000
# Temperature for EAGLE-3 draft sampling
# NSA_EAGLE3_TEMPERATURE=0.2

# NUMA topology gate (GCP C4A / Axion = single UMA → bind stays off)
# auto = numactl+llama --numa only when guest numa_nodes > 1
# off  = never bind
# force = still cannot invent nodes; no-op with warning when nodes==1
NSA_NUMA_POLICY=auto
# When policy=auto and nodes>1, set 0 to disable bind planning
NSA_NUMA_BIND=1

# Locality scheduler (preferred framing on Axion: cache-aware affinity, not NUMA-split)
# auto = numa_aware when nodes>1 else cache_aware core partitions
# uma_affinity = force core partitions even if multi-node
# numa = prefer numactl (falls back to cache_aware when nodes==1)
# off = OS default
NSA_LOCALITY_MODE=auto
# c4a-standard-8: draft 0-1, verifier mid 2-4, verifier large 5-7
NSA_TIER1_CPUSET=0-1
NSA_TIER2_CPUSET=2-4
NSA_TIER3_CPUSET=5-7
OMP_PROC_BIND=close
OMP_WAIT_POLICY=passive
OMP_PLACES=cores
OMP_PLACES=cores

# AWPP Layer 4 — predictive pre-warm (frequency/Markov; PPO is Phase 2 offline)
# Default CPU budget is 1% of a rolling 1s window; raise only with evidence.
NSA_AWPP_MAX_CPU_FRACTION=0.01
NSA_AWPP_CONFIDENCE_THRESHOLD=0.35
NSA_AWPP_ACTIVE_POLICY=markov
NSA_AWPP_RATE_LIMIT=20
NSA_AWPP_MAX_CONCURRENT=4
NSA_AWPP_WARM_TIMEOUT_S=5
NSA_AWPP_ALWAYS_WARM_TIER1=1
NSA_AWPP_SHADOW=0
# NSA_AWPP_POLICY_PATH=work/awpp/policies/markov.json
# NSA_AWPP_ROOT=work/awpp

# Live llama-server KV cache inspection (per tier :8081-8083)
# NSA_TIER1_URL=http://127.0.0.1:8081
# NSA_TIER2_URL=http://127.0.0.1:8082
# NSA_TIER3_URL=http://127.0.0.1:8083
# python scripts/kv_cache_status.py
# curl http://127.0.0.1:8000/v1/kv-cache/status

# KV Memory Runtime (Plane 2)
NSA_KV_STORE=work/kv
NSA_KV_BLOCK_SIZE=256
NSA_KV_RAM_BUDGET=536870912
NSA_KV_PRESSURE_THRESHOLD=0.70
NSA_KV_COMPRESSION=zstd
NSA_KV_SHARING_BACKEND=mmap
NSA_KV_REDIS_URL=redis://localhost:6379/0
NSA_KV_BG_MIGRATION=1

# Host monitors (compose profile hostmon: cadvisor + glances)
# Bring-up on Axion: docker compose --profile hostmon up -d cadvisor glances glances-web
# Host TUI: bash scripts/install-host-monitors.sh && btop
# NSA_GLANCES_URL=http://127.0.0.1:61208
# Glances UI :61208  | Glances Prometheus :61209  | cAdvisor :8088
# Obs Prometheus scrapes 10.128.0.2:{8088,61209} — restrict with VPC firewall

# MLX backend (Apple Silicon M3/M4/M5 — native Metal inference)
NSA_MLX_MODEL_PATH=/models/mlx/llama-3.2-3b-instruct-4bit
NSA_MLX_DRAFT_MODEL_PATH=/models/mlx/llama-3.2-1b-instruct-4bit
NSA_MLX_NUM_DRAFT_TOKENS=5
NSA_MLX_PORT=8080

# Hermes tool_search — deferrable tool discovery bridge.
# https://hermes-agent.nousresearch.com/docs/user-guide/features/tool-search
# YAML equivalent:
#   tools:
#     tool_search:
#       enabled: auto
#       threshold_pct: 10
#       search_default_limit: 5
#       max_search_limit: 20
#       listing: auto
#       listing_max_tokens: 20000
TOOL_SEARCH_ENABLED=auto
TOOL_SEARCH_THRESHOLD_PCT=10
TOOL_SEARCH_DEFAULT_LIMIT=5
TOOL_SEARCH_MAX_LIMIT=20
TOOL_SEARCH_LISTING=auto
TOOL_SEARCH_LISTING_MAX_TOKENS=20000
